# Copy this file to .env and it will work out of the box with Docker
# Run: copy .env.example .env   (Windows)  OR  cp .env.example .env  (Mac/Linux)

DATABASE_URL=postgresql+psycopg2://gateway_user:gateway_password@127.0.0.1:5432/gateway_db
JWT_SECRET=dev-secret-change-later
JWT_ALGORITHM=HS256
REDIS_URL=redis://localhost:6379/0